<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Necesario para instalar el APK descargado de un GitHub Release. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- Sin publicidad ni analítica de terceros: no se declara el Advertising ID. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <!-- Soporte para Android TV y Tablets: leanback no requerido permite que Play Store
         y los dispositivos táctiles (Tablets) puedan instalar la aplicación manteniendo 
         compatibilidad total con Android TV y Google TV. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <supports-screens
        android:smallScreens="true"
        android:normalScreens="true"
        android:largeScreens="true"
        android:xlargeScreens="true"
        android:anyDensity="true" />

    <queries>
        <package android:name="org.jellyfin.androidtv" />
        <package android:name="org.jellyfin.mobile" />
        <package android:name="org.jellyfin.androidtv.debug" />
        <package android:name="org.jellyfin.mobile.debug" />
        <package android:name="com.mb.android" />
        <package android:name="org.xbmc.kodi" />
        <package android:name="org.videolan.vlc" />
        <package android:name="com.brouken.player" />
        <package android:name="com.mxtech.videoplayer.ad" />
        <package android:name="com.mxtech.videoplayer.pro" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="video/*" />
        </intent>
    </queries>

    <application
        android:name=".MedusaApplication"
        android:allowBackup="false"
        android:largeHeap="true"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.Medusa">

        <!-- Hilt inyecta HiltWorkerFactory vía Configuration.Provider; se elimina el
             inicializador por defecto de WorkManager para que se use esa configuración. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:banner="@drawable/banner"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            android:supportsPictureInPicture="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="medusa" android:host="player" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- No se declara un foreground service de tipo mediaPlayback porque la app no
             reproduce en segundo plano: al recibir ON_STOP pausa ExoPlayer y envía
             PlaybackStopped a Jellyfin. Si en el futuro se habilita reproducción en
             background, habrá que añadir el servicio con android:foregroundServiceType=
             "mediaPlayback" y los permisos FOREGROUND_SERVICE_MEDIA_PLAYBACK. -->
    </application>

</manifest>